[Unit]
Description=LLM Harness mobile agent control service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=llm-harness
Group=llm-harness
EnvironmentFile=/etc/llm-harness/agent-control.env
ExecStart=/usr/local/bin/llm-harness-agent-control /etc/llm-harness/agent-control.json
StateDirectory=llm-harness/agent-control
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
